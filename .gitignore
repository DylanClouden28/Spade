# Ignorned vscode config for the project
.vscode

# Ignore pycache files
*pycache*

# Ignored python venv
venv

# Ignore env file
.env

# Ignore files in downloaded_data
*/downloaded_data/*
!*/downloaded_data/.gitkeep

# Ignore sqlite file
*/database/*
!*/database/.gitkeep

# Ignore rendered graphs
rendered_graphs/*
!rendered_graphs/.gitkeep